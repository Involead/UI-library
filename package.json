{
  "name": "involead-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w storybook-app",
    "storybook": "npm run storybook -w storybook-app",
    "build:ui": "npm run build -w @involead/ui",
    "build-storybook": "npm run build-storybook -w storybook-app",
    "test": "npm run test -w @involead/ui",
    "lint": "npm run lint --workspaces --if-present"
  }
}
